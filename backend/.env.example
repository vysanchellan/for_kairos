# Copy to backend/.env for local development. Every value is optional.
# No real keys or credentials are needed anywhere in this project.

# Turn on for local debugging only. Defaults to off.
DJANGO_DEBUG=true

# Leave empty to get a random key per process (fine for this app: there are no sessions).
DJANGO_SECRET_KEY=

# Comma-separated host names Django will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite file location. Defaults to backend/db.sqlite3.
# DATABASE_PATH=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
